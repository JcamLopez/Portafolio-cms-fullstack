# Servidor
PORT=3000
DATABASE_URL="mysql://usuario:password@localhost:3306/portafolio"

# JWT — secreto aleatorio de al menos 32 caracteres. Generar con:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=1d

# Orígenes permitidos por CORS, separados por comas
CORS_ORIGINS=http://localhost:5173
