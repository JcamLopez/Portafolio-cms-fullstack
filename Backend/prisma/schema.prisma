// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// =============================================================
// Enums
// =============================================================

enum SocialPlatform {
  GITHUB
  LINKEDIN
  X
  YOUTUBE
  INSTAGRAM
  WEBSITE
  EMAIL
  OTHER
}

enum SkillCategory {
  LANGUAGE // JavaScript, TypeScript, Python, Java
  FRONTEND // React
  BACKEND // Node.js, Express
  DATABASE // SQL, MySQL
  DEVOPS // Docker, CI/CD
  CLOUD // AWS, Azure, GCP
  TESTING // QA, pruebas manuales/automatizadas
  IOT
  TOOL
  OTHER
}

enum SkillLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  EXPERT
}

enum ExperienceType {
  JOB
  TEACHING // Instructor técnico (IoT, Integración de Contenidos Digitales)
  FREELANCE
  INTERNSHIP
  VOLUNTEER
}

enum WorkModality {
  ONSITE
  REMOTE
  HYBRID
}

enum EducationType {
  UNDERGRADUATE // Ingeniería de Sistemas
  MASTER // Máster en DevOps y Cloud
  DIPLOMADO
  BOOTCAMP // QA Tester
  COURSE
  CERTIFICATION
}

enum UserRole {
  ADMIN
  EDITOR
}

enum MessageStatus {
  UNREAD
  READ
  REPLIED
  ARCHIVED
  SPAM
}

// =============================================================
// Users (autenticación)
// =============================================================

model User {
  id        String   @id @default(uuid()) @db.Char(36)
  email     String   @unique @db.VarChar(191)
  password  String   @db.VarChar(255) // hash bcrypt, nunca el texto plano
  name      String?  @db.VarChar(120)
  role      UserRole @default(ADMIN)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// =============================================================
// Profile
// =============================================================

model Profile {
  id               Int          @id @default(autoincrement())
  fullName         String       @db.VarChar(120)
  headline         String       @db.VarChar(160) // "Ingeniero de Sistemas | DevOps & Cloud | QA"
  subheadline      String?      @db.VarChar(255)
  bio              String?      @db.Text
  location         String?      @db.VarChar(120) // "Colombia"
  email            String?      @db.VarChar(191)
  phone            String?      @db.VarChar(30)
  avatarUrl        String?      @db.VarChar(500)
  resumeUrl        String?      @db.VarChar(500)
  availableForWork Boolean      @default(true)
  socialLinks      SocialLink[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
}

model SocialLink {
  id        Int            @id @default(autoincrement())
  platform  SocialPlatform
  label     String?        @db.VarChar(60)
  url       String         @db.VarChar(500)
  order     Int            @default(0)
  profileId Int
  profile   Profile        @relation(fields: [profileId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([profileId, platform, url])
  @@index([profileId])
}

// =============================================================
// Projects
// =============================================================

model Project {
  id            Int            @id @default(autoincrement())
  title         String         @db.VarChar(150)
  slug          String         @unique @db.VarChar(160)
  summary       String?        @db.VarChar(300) // Texto corto para tarjetas
  description   String         @db.Text
  coverImageUrl String?        @db.VarChar(500)
  images        ProjectImage[]
  repoUrl       String?        @db.VarChar(500)
  demoUrl       String?        @db.VarChar(500)
  isPublished   Boolean        @default(false) // false = borrador
  isFeatured    Boolean        @default(false)
  publishedAt   DateTime?
  order         Int            @default(0)
  skills        Skill[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([isPublished, order])
}

model ProjectImage {
  id        Int      @id @default(autoincrement())
  url       String   @db.VarChar(500)
  altText   String?  @db.VarChar(200)
  order     Int      @default(0)
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([projectId])
}

// =============================================================
// Skills
// =============================================================

model Skill {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(80)
  slug        String        @unique @db.VarChar(90)
  category    SkillCategory
  level       SkillLevel?
  iconUrl     String?       @db.VarChar(500)
  color       String?       @db.VarChar(9) // Hex, ej. "#3178C6"
  isFeatured  Boolean       @default(false)
  order       Int           @default(0)
  projects    Project[]
  experiences Experience[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([category, order])
}

// =============================================================
// Experience
// =============================================================

model Experience {
  id           Int            @id @default(autoincrement())
  role         String         @db.VarChar(150)
  organization String         @db.VarChar(150)
  type         ExperienceType
  modality     WorkModality?
  location     String?        @db.VarChar(120)
  startDate    DateTime       @db.Date
  endDate      DateTime?      @db.Date // null = actualmente
  isCurrent    Boolean        @default(false)
  description  String         @db.Text
  highlights   Json? // Lista de logros: ["...", "..."]
  companyUrl   String?        @db.VarChar(500)
  logoUrl      String?        @db.VarChar(500)
  order        Int            @default(0)
  skills       Skill[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@index([startDate])
}

// =============================================================
// Education
// =============================================================

model Education {
  id            Int           @id @default(autoincrement())
  institution   String        @db.VarChar(150)
  title         String        @db.VarChar(150) // "Máster en DevOps y Cloud"
  fieldOfStudy  String?       @db.VarChar(150)
  type          EducationType
  startDate     DateTime?     @db.Date
  endDate       DateTime?     @db.Date
  isCurrent     Boolean       @default(false)
  description   String?       @db.Text
  credentialUrl String?       @db.VarChar(500)
  logoUrl       String?       @db.VarChar(500)
  order         Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([type, endDate])
}

// =============================================================
// Contact messages
// =============================================================

model Message {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(120)
  email     String        @db.VarChar(191)
  subject   String?       @db.VarChar(200)
  content   String        @db.Text
  status    MessageStatus @default(UNREAD)
  ipAddress String?       @db.VarChar(45) // IPv4/IPv6, útil para anti-spam
  userAgent String?       @db.VarChar(500)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@index([status, createdAt])
  @@index([email])
}
